<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/buttonInclinationActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_level_indicator"
        app:layout_constraintBottom_toTopOf="@+id/buttonCompassActivity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/buttonCompassActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_compass"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonWeatherActivity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonInclinationActivity" />

    <Button
        android:id="@+id/buttonWeatherActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_barometer"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonGForceActivity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonCompassActivity" />

    <Button
        android:id="@+id/buttonGForceActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/show_g_force_meter"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonWeatherActivity" />

</androidx.constraintlayout.widget.ConstraintLayout>